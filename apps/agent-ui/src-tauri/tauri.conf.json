{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Contixis Agent",
  "version": "0.1.0",
  "identifier": "io.contixis.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Contixis Agent",
        "width": 480,
        "height": 620,
        "minWidth": 400,
        "minHeight": 500,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libsoup-3.0-0",
          "libjavascriptcoregtk-4.1-0",
          "libgtk-3-0",
          "libglib2.0-0"
        ]
      }
    }
  }
}
